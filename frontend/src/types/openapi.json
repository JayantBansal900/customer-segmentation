{
  "openapi": "3.1.0",
  "info": {
    "title": "SegmentIQ Analysis API",
    "description": "Synchronous local RFM segmentation. No database, accounts, or background jobs.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "description": "Report this process's availability only.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/analyze": {
      "post": {
        "tags": [
          "analysis"
        ],
        "summary": "Analyze",
        "description": "Analyze one CSV/XLSX upload or the explicitly selected built-in example.",
        "operationId": "analyze_api_analyze_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "oneOf": [
                  {
                    "properties": {
                      "use_example": {
                        "const": false
                      }
                    },
                    "required": [
                      "file"
                    ]
                  },
                  {
                    "not": {
                      "required": [
                        "file"
                      ]
                    },
                    "properties": {
                      "use_example": {
                        "const": true
                      }
                    },
                    "required": [
                      "use_example"
                    ]
                  }
                ],
                "properties": {
                  "selected_k": {
                    "type": "integer",
                    "maximum": 50.0,
                    "minimum": 2.0,
                    "title": "Selected K",
                    "description": "Chosen cluster count; never replaced by recommendation."
                  },
                  "candidate_k_min": {
                    "type": "integer",
                    "maximum": 50.0,
                    "minimum": 2.0,
                    "title": "Candidate K Min",
                    "description": "Inclusive candidate lower bound."
                  },
                  "candidate_k_max": {
                    "type": "integer",
                    "maximum": 50.0,
                    "minimum": 2.0,
                    "title": "Candidate K Max",
                    "description": "Inclusive candidate upper bound."
                  },
                  "preprocessing": {
                    "type": "string",
                    "enum": [
                      "raw_standard",
                      "log1p_standard"
                    ],
                    "title": "Preprocessing",
                    "description": "Maps to baseline/log1p in the existing engine.",
                    "default": "raw_standard"
                  },
                  "use_example": {
                    "type": "boolean",
                    "title": "Use Example",
                    "description": "Use the bundled Online Retail.xlsx instead of a file.",
                    "default": false
                  },
                  "date_format": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 100
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Date Format",
                    "description": "Explicit format for non-ISO uploaded dates, e.g. %d/%m/%Y."
                  },
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "CSV or XLSX; mutually exclusive with use_example=true."
                  }
                },
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "selected_k",
                  "candidate_k_min",
                  "candidate_k_max"
                ],
                "title": "AnalysisParameters",
                "description": "Multipart text fields; file/example exclusivity is checked separately."
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Request Entity Too Large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
