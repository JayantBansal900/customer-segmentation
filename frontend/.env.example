# Browser API origin: leave empty for same-origin /api routing.
# For separate HTTPS hosting set this before building, e.g. https://api.example.com
# VITE_* values are public browser configuration, never secrets.
VITE_API_BASE_URL=
# Development/preview proxy only; not a production reverse proxy.
API_PROXY_TARGET=http://127.0.0.1:8000
# Keep the preliminary client limit aligned with the backend upload policy.
VITE_MAX_UPLOAD_BYTES=67108864
VITE_ANALYSIS_TIMEOUT_MS=300000
