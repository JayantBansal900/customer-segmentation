{
  "name": "segmentiq-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "generate:types": "openapi-typescript src/types/openapi.json -o src/types/schema.d.ts",
    "verify:http": "node scripts/verify-http.mjs",
    "sync:contract": "node scripts/sync-contract.mjs && npm run generate:types"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "papaparse": "5.7.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "jsdom": "30.1.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/papaparse": "5.5.2",
    "@types/node": "26.6.5",
    "openapi-typescript": "7.13.0"
  }
}
