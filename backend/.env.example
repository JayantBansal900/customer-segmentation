# Export these in the process environment or hosting control panel.
# This application does not automatically load dotenv files.
SEGMENTIQ_MAX_UPLOAD_BYTES=67108864
SEGMENTIQ_MULTIPART_OVERHEAD_BYTES=1048576
SEGMENTIQ_MAX_XLSX_EXPANDED_BYTES=536870912
SEGMENTIQ_MAX_CONCURRENT_ANALYSES=1
# Explicit comma-separated origins, no paths/trailing slash/wildcards/credentials.
# HTTPS is required outside loopback. For separate hosting replace with the real
# frontend origin, e.g. https://app.example.com. Same-origin can use an empty value.
SEGMENTIQ_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set these BEFORE launching Python to bound native numerical library threads.
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
